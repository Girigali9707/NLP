def fsa_ends_with_ab(string):
    # States:
    # q0 = Start state
    # q1 = Last character is 'a'
    # q2 = String ends with 'ab' (Accept state)

    state = "q0"

    for ch in string:
        if state == "q0":
            if ch == 'a':
                state = "q1"
            else:
                state = "q0"

        elif state == "q1":
            if ch == 'a':
                state = "q1"
            elif ch == 'b':
                state = "q2"
            else:
                state = "q0"

        elif state == "q2":
            if ch == 'a':
                state = "q1"
            else:
                state = "q0"

    return state == "q2"


# Test the automaton
test_strings = ["ab", "aab", "cab", "abab", "abc", "baa", "bab"]

for s in test_strings:
    if fsa_ends_with_ab(s):
        print(f"{s} -> Accepted")
    else:
        print(f"{s} -> Rejected")